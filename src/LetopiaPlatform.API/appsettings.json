{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/letopia-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
            },
            {
                "Name": "ApplicationInsights",
                "Args": {
                    "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
                }
            }
        ],
        "Enrich": [
            "FromLogContext"
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "SET_VIA_USER_SECRETS"
    },
  "JwtSettings": {
    "Issuer": "LetopiaPlatformAPI",
    "Audience": "LetopiaPlatformClients",
    "SecretKey": "SET_VIA_USER_SECRETS",
    "ExpiryInMinutes": 2,
    "RefreshTokenExpiryInDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
    "AgentSettings": {
        "GroqApiKey": "SET_VIA_USER_SECRETS",
        "GroqEndpoint": "https://api.groq.com/openai/v1",
        "GroqModelId": "llama-3.3-70b-versatile",
        "GeminiApiKey": "SET_VIA_USER_SECRETS",
        "GeminiEndpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "GeminiModelId": "gemini-2.5-flash",
        "MaxConversationTokens": 4000
    },
    "WebSearchSettings": {
        "TavilyApiKey": "SET_VIA_USER_SECRETS"
    },
    "SeedData": {
        "AdminEmail": "SET_VIA_USER_SECRETS",
        "AdminPassword": "SET_VIA_USER_SECRETS"
    },
    "CorsSettings": {
        "AllowedOrigins": [
            "http://localhost:3000",
            "http://localhost:5174"
        ]
    },
    "FileStorage": {
        "Provider": "Local"
    },
    "GoogleAuthSettings": {
        "ClientId": "SET_VIA_USER_SECRETS"
    },
    "SmtpSettings": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "SenderEmail": "SET_VIA_USER_SECRETS",
        "SenderName": "Letopia",
        "Username": "SET_VIA_USER_SECRETS",
        "Password": "SET_VIA_USER_SECRETS",
        "UseSsl": true
    }
}
